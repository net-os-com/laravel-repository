{
    "name": "net-os/laravel-repository",
    "license": "proprietary",
    "type": "package",
    "description": "Using repositories in Laravel",
    "readme": "README.md",
    "authors": [
        {
            "name": "Net OS B.V.",
            "email": "software@net-os.com",
            "homepage": "https://net-os.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "NetOS\\Repository\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NetOS\\Repository\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NetOS\\Repository\\RepositoryServiceProvider"
            ]
        }
    }
}
